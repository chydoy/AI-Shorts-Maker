# База данных и Redis
DATABASE_URL=postgresql://postgres:postgres@db:5432/ai_shorts_db
REDIS_URL=redis://redis:6379/0

# Настройки Faster-Whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Настройки LLM API (Groq / OpenAI / OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
